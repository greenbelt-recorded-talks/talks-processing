# Port 80 and port 443 are both first-class ways in, and there is deliberately
# no redirect between them. A machine whose trust store has not been set up
# yet - a volunteer's own laptop, a replacement built mid-festival - still gets
# a working site over HTTP instead of a certificate warning it cannot dismiss
# its way past. For the same reason there is no HSTS header: one visit would
# pin HTTPS in the browser and take the fallback away.

server {
    listen 80;
    server_name gbtalks.local
                talks-processing.greenbelt.org.uk
                on-site.talks-processing.greenbelt.org.uk;

    client_max_body_size 1G;

    # Has to be served over plain HTTP as well as HTTPS: a machine that does
    # not yet hold the CA certificate cannot fetch it over a connection that
    # certificate is what makes trustworthy.
    location = /gbtalks-ca.crt {
        alias /etc/ssl/certs/gbtalks-ca.crt;
        default_type application/x-x509-ca-cert;
    }

    # The talks page renders an <audio> player for every file of every talk,
    # and each one probes its file for a duration on page load. Serving those
    # through uWSGI is what made the page unusable: with processes = 1 the
    # transfers serialise, and the buffering below drains the whole 150 MB file
    # out of the worker even after the browser has cancelled - so the players
    # all time out and show 00:00. Flask does the auth check and names the file
    # in an X-Accel-Redirect header; these locations are where it lands.
    #
    # internal, so none of this is reachable from the network - a request for
    # /_storage/... straight off the wire is a 404. Flask is the only way in,
    # and it is still the thing deciding which file you get.
    #
    # The paths mirror config.py's defaults. Override UPLOAD_DIR and friends in
    # the environment and these have to move with them, or the app will hand
    # nginx a name it cannot resolve.
    location /_storage/uploads/   { internal; alias /storage/uploads/; }
    location /_storage/processed/ { internal; alias /storage/processed/; }
    location /_storage/images/    { internal; alias /storage/images/; }
    location /_storage/web_mp3s/  { internal; alias /storage/web_mp3s/; }

    location / {
        include uwsgi_params;
        uwsgi_pass unix:/tmp/gbtalks.sock;
    }
}

server {
    # http2 as a listen parameter rather than the newer standalone "http2 on;"
    # directive, which arrived in nginx 1.25.1. Noble ships 1.24.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gbtalks.local
                talks-processing.greenbelt.org.uk
                on-site.talks-processing.greenbelt.org.uk;

    # Issued by the internal CA in the playbook. Nothing here is renewed
    # automatically: the certificates are good for ten years, and reissuing
    # early would silently break every machine that trusts the current CA.
    ssl_certificate     /etc/ssl/certs/gbtalks.crt;
    ssl_certificate_key /etc/ssl/private/gbtalks.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    client_max_body_size 1G;

    location = /gbtalks-ca.crt {
        alias /etc/ssl/certs/gbtalks-ca.crt;
        default_type application/x-x509-ca-cert;
    }

    # The talks page renders an <audio> player for every file of every talk,
    # and each one probes its file for a duration on page load. Serving those
    # through uWSGI is what made the page unusable: with processes = 1 the
    # transfers serialise, and the buffering below drains the whole 150 MB file
    # out of the worker even after the browser has cancelled - so the players
    # all time out and show 00:00. Flask does the auth check and names the file
    # in an X-Accel-Redirect header; these locations are where it lands.
    #
    # internal, so none of this is reachable from the network - a request for
    # /_storage/... straight off the wire is a 404. Flask is the only way in,
    # and it is still the thing deciding which file you get.
    #
    # The paths mirror config.py's defaults. Override UPLOAD_DIR and friends in
