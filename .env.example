# Add any env vars for configuration here
# e.g. export SECRET_KEY=sekritvalue

# Google Login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTHLIB_RELAX_TOKEN_SCOPE=true
OAUTHLIB_INSECURE_TRANSPORT=true
SECRET_KEY=sekritvalue

# Which deployment this is, shown as a badge in the navbar: cloud | onsite.
# Detected automatically (PythonAnywhere sets PYTHONANYWHERE_DOMAIN, the
# festival server does not), so only set this to override the guess.
# DEPLOYMENT_ENV=onsite
